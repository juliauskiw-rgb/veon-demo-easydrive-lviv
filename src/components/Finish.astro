---
import { phones, hours, socials, email } from "../data/site";
---
<section id="finish" class="section section--brand fin" aria-labelledby="fin-title">
  <div class="container fin__grid">
    <div class="fin__main">
      <h2 id="fin-title" class="h2">Запис за телефоном</h2>
      <p class="fin__num num" aria-hidden="true">07-07-076</p>
      <p class="lead">Один номер у трьох мережах: дзвоніть зі свого оператора.</p>
      <ul class="fin__ops" role="list" data-rec="R-208">
        {phones.map((p) => (
          <li>
            <a class="fin__op" href={`tel:${p.tel}`} aria-label={`Подзвонити: ${p.full}, ${p.operator}`}>
              <span class="fin__op-n num">{p.short}</span>
              <span class="fin__op-o">{p.operator}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="fin__hours"><span class="muted">Приймаємо дзвінки</span> <strong class="num nowrap">{hours.text}</strong></p>
    </div>

    <div class="fin__side">
      <div class="fin__block">
        <h3 class="fin__h">Поза робочим часом</h3>
        <p><a class="fin__link" href={socials.instagram.url} target="_blank" rel="noopener">Написати в Instagram</a></p>
        <p><a class="fin__link" href={`mailto:${email}`}>{email}</a></p>
      </div>
      <div class="fin__block">
        <h3 class="fin__h">Що взяти для вступу</h3>
        <p>Копію паспорта, копію ІПН, медичну довідку Ф-083 і 2 фото 3,5×4,5 см.</p>
      </div>
      <div class="fin__block">
        <h3 class="fin__h">Про нас пишуть</h3>
        <p>Fakty.com.ua у серпні 2025 року включили EasyDrive до добірки «5 найкращих автошкіл у Львові».</p>
      </div>
    </div>
  </div>
</section>

<style>
  .fin__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-2xl) var(--space-3xl); align-items: end; }
  .fin__main { display: grid; gap: var(--space-lg); }
  .fin__num {
    margin: 0; font-family: var(--font-display); font-style: var(--slant); font-weight: 800;
    font-size: clamp(3.5rem, 1.2rem + 9.4vw, 9.5rem); line-height: .9; letter-spacing: -0.03em; white-space: nowrap;
  }
  .fin__ops { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-sm); margin: var(--space-xs) 0 0; padding: 0; list-style: none; }
  .fin__op {
    display: grid; gap: var(--space-2xs); align-content: center;
    min-height: 72px; padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius); background: var(--color-ink); color: var(--color-brand);
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out);
  }
  .fin__op-n { font-weight: 600; font-size: var(--text-lead); white-space: nowrap; }
  .fin__op-o { font-size: var(--text-sm); color: var(--color-paper); }
  .fin__op:hover { background: var(--color-asphalt-2); }
  .fin__op:active { transform: scale(.98); }
  .fin__op:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 3px; }
  .fin__hours { margin: 0; }

  .fin__side { display: grid; gap: var(--space-lg); }
  .fin__block { border-top: var(--rule-w) solid var(--color-ink); padding-top: var(--space-sm); }
  .fin__block p { margin: var(--space-2xs) 0 0; }
  .fin__h { margin: 0; font: 600 var(--text-md)/1.4 var(--font-body); }
  .fin__link {
    white-space: nowrap;
    display: inline-flex; align-items: center; min-height: 44px; font-weight: 600;
    text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; overflow-wrap: anywhere;
  }
  .fin__link:hover { text-decoration-thickness: 3px; }
  .fin__link:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 2px; border-radius: 2px; }

  @media (max-width: 60rem) {
    .fin__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .fin__ops { grid-template-columns: minmax(0, 1fr); }
    .fin__op { min-height: 60px; grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fin__op { transition: none; }
    .fin__op:active { transform: none; }
  }
</style>
