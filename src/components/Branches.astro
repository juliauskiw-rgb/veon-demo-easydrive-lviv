---
import Chevrons from "./Chevrons.astro";
import { branches, hours, mapUrl, mainPhone } from "../data/site";
const city = branches.filter((b) => b.town === "Львів");
const towns = branches.filter((b) => b.town !== "Львів");
const groups = [
  { title: "Львів", items: city },
  { title: "Винники і Рясне", items: towns },
];
---
<section id="branches" class="section section--paper br" aria-labelledby="br-title">
  <div class="container">
    <div class="br__head">
      <h2 id="br-title" class="h2">Філія біля дому: шість адрес</h2>
      <p class="br__hours" data-rec="R-208"><span class="muted">Усі філії працюють</span> <strong class="num nowrap">{hours.text}</strong></p>
    </div>

    <div class="br__lines">
      {groups.map((g) => (
        <div class="br__group">
          <h3 class="br__town">{g.title}</h3>
          <ol class="br__list" role="list">
            {g.items.map((b) => (
              <li class="br__stop">
                <span class="br__node" aria-hidden="true"></span>
                <p class="br__street">{b.town !== "Львів" && <span>{b.town}, </span>}{b.street}</p>
                {b.landmark && <p class="br__mark small muted">{b.landmark}</p>}
                <a class="br__map small" href={mapUrl} target="_blank" rel="noopener" aria-label={`Відкрити на карті: ${b.town}, ${b.street} (Google Карти, нова вкладка)`}>Відкрити на карті</a>
              </li>
            ))}
          </ol>
          {g.items.length < 4 && (
            <div class="br__call">
              <p class="small muted">Не знаєте, яка філія ближче? Підкажемо телефоном.</p>
              <a class="tlink" href={`tel:${mainPhone.tel}`}><span>Обрати філію: <span class="num nowrap">{mainPhone.short}</span></span><Chevrons /></a>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .br__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-md) var(--space-xl); margin-bottom: var(--space-2xl); }
  .br__hours { margin: 0; font-size: var(--text-lead); }
  .br__lines { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2xl) var(--gap); }
  .br__town { margin: 0 0 var(--space-lg); font: 600 var(--text-md)/1.3 var(--font-body); color: var(--color-muted); }

  /* A line with stops: ink line 2 px, round nodes; a node fills with yellow on hover/focus (effect 5) */
  .br__list { margin: 0; padding: 0; list-style: none; position: relative; }
  .br__stop { position: relative; padding: 0 0 var(--space-xl) var(--space-2xl); }
  .br__stop::before {
    content: ""; position: absolute; left: calc((var(--space-lg) - var(--rule-w)) / 2); top: var(--space-md); bottom: 0;
    width: var(--rule-w); background: var(--color-ink);
  }
  .br__stop:last-child { padding-bottom: 0; }
  .br__stop:last-child::before { display: none; }
  .br__node {
    position: absolute; left: 0; top: var(--space-2xs);
    width: var(--space-lg); height: var(--space-lg); border-radius: 50%;
    background: var(--color-paper); box-shadow: inset 0 0 0 4px var(--color-ink);
    transition: background-color var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);
  }
  .br__stop:hover .br__node, .br__stop:focus-within .br__node { background: var(--color-brand); transform: scale(1.12); }
  .br__street {
    margin: 0; font-family: var(--font-display); font-style: var(--slant); font-weight: 800;
    font-size: var(--text-title); line-height: 1.12; letter-spacing: -0.015em; text-wrap: balance;
  }
  .br__mark { margin: var(--space-2xs) 0 0; }
  .br__map {
    display: inline-flex; align-items: center; min-height: 44px; font-weight: 600;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px;
  }
  .br__map:hover { text-decoration-thickness: 2px; }
  .br__map:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 2px; border-radius: 2px; }
  .br__call { margin-top: var(--space-2xl); padding-top: var(--space-lg); border-top: 1px solid var(--color-rule); }
  .br__call p { margin: 0 0 var(--space-xs); }

  @media (max-width: 60rem) {
    .br__head { margin-bottom: var(--space-xl); }
    .br__lines { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .br__stop { padding-left: var(--space-xl); padding-bottom: var(--space-lg); }
    .br__street { font-size: var(--text-lead); }
  }
  @media (prefers-reduced-motion: reduce) {
    .br__node { transition: none; }
    .br__stop:hover .br__node, .br__stop:focus-within .br__node { transform: none; }
  }
</style>
