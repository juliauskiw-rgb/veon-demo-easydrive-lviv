---
import Chevrons from "./Chevrons.astro";
import { phones, mainPhone, hours, route } from "../data/site";
const others = phones.slice(1);
---
<section id="hero" class="hero" aria-labelledby="hero-title" data-rec="R-205">
  <div class="container hero__body">
    <h1 id="hero-title" class="display hero__title">Автошкола EasyDrive у Львові — від першого уроку до іспиту в ТСЦ</h1>
    <p class="lead hero__lead">Категорії A, A1, B, C і C1, шість філій у Львові, Винниках і Рясному.</p>
    <div class="hero__actions" data-rec="R-208">
      <a class="btn nowrap hero__call" href={`tel:${mainPhone.tel}`} data-hero-call>
        <span>Подзвонити: <span class="num">{mainPhone.short}</span></span><Chevrons />
      </a>
      <p class="hero__alt">
        <span class="muted">Або з іншої мережі:</span>
        {others.map((p, i) => <>{i > 0 && <span class="muted" aria-hidden="true">·</span>}<a class="hero__alt-link num" href={`tel:${p.tel}`} aria-label={`Подзвонити: ${p.full}, ${p.operator}`}>{p.short}</a></>)}
      </p>
      <p class="hero__hours small muted">Відповідаємо {hours.text}</p>
    </div>
  </div>

  <nav class="road" aria-label="Маршрут навчання по сторінці">
    <div class="road__marking" aria-hidden="true"></div>
    <ol class="container road__list" role="list">
      {route.map((r, i) => (
        <li>
          <a class="road__seg" href={`#${r.id}`}>
            <span class="road__n num" aria-hidden="true">{i + 1}</span>
            <span class="road__label">{r.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</section>

<style>
  .hero {
    background: var(--color-brand); color: var(--color-ink);
    display: grid; grid-template-rows: 1fr auto; grid-template-columns: minmax(0, 1fr);
    min-height: calc(100svh - var(--header-h));
  }
  .hero__body {
    display: grid; align-content: center; gap: var(--space-lg);
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .hero__title { max-width: 21ch; }
  .hero__lead { color: var(--color-ink); max-width: 44ch; }
  .hero__actions { display: grid; justify-items: start; gap: var(--space-sm); margin-top: var(--space-md); }
  .hero__call { white-space: nowrap; min-height: var(--btn-h); padding-inline: var(--space-lg); font-size: var(--text-lead); }
  .hero__alt { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2xs) var(--space-md); margin: 0; }
  .hero__alt-link {
    display: inline-flex; align-items: center; min-height: 44px;
    font-weight: 600; color: var(--color-ink); white-space: nowrap;
    text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px;
  }
  .hero__alt-link:hover { text-decoration-thickness: 3px; }
  .hero__alt-link:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 2px; border-radius: 2px; }
  .hero__hours { margin: 0; }

  /* The road band: asphalt with the yellow dashed centre line and five anchor segments */
  .road { background: var(--color-ink); color: var(--color-paper); padding-block: var(--space-lg) var(--space-md); --color-accent: var(--color-brand); }
  /* One painted line: dashes 24 / 16 px (concept.md § Линия маршрута), drawn left to right on load (effect 1) */
  .road__marking {
    height: 6px; margin-inline: var(--space);
    background: repeating-linear-gradient(90deg, var(--color-brand) 0 var(--space-lg), transparent var(--space-lg) calc(var(--space-lg) + var(--space-md)));
    transform-origin: left;
    animation: dash-in 700ms var(--ease-out) both;
  }
  @keyframes dash-in { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .road__list {
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--gap);
    margin-top: var(--space-md); padding: 0; list-style: none;
  }
  .road__seg {
    display: flex; align-items: baseline; gap: var(--space-sm);
    min-height: 56px; padding-block: var(--space-xs);
    color: var(--color-paper); text-decoration: none;
    border-top: 2px solid var(--color-asphalt-2);
    transition: border-color var(--dur-short) var(--ease-out);
  }
  .road__n { font-family: var(--font-display); font-style: var(--slant); font-weight: 800; font-size: var(--text-title); color: var(--color-brand); line-height: 1; }
  .road__label { font-weight: 600; white-space: nowrap; }
  .road__seg:hover { border-top-color: var(--color-brand); }
  .road__seg:hover .road__label { text-decoration: underline; text-underline-offset: 5px; }
  .road__seg:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 2px; }

  @media (max-width: 60rem) {
    .hero { min-height: 0; }
    .hero__body { align-content: start; padding-block: var(--space-xl) var(--space-xl); gap: var(--space-md); }
    .hero__actions { justify-items: stretch; }
    .hero__call { min-height: 56px; font-size: var(--text-md); }
    /* On phones the road becomes a rail: the next segment is cut by the edge */
    .road__list {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: minmax(9.5rem, 42%);
      overflow-x: auto; scroll-snap-type: x mandatory; width: 100%; padding-inline: var(--space);
      scroll-padding-inline: var(--space); gap: var(--space-md); scrollbar-width: none;
      margin-top: var(--space-xs);
    }
    .road { padding-block: var(--space-md) var(--space-2xs); }
    .road__seg { min-height: 48px; }
    .road__list > li { scroll-snap-align: start; }
    .hero__alt { display: grid; grid-template-columns: repeat(2, max-content); column-gap: var(--space-lg); }
    .hero__alt > .muted { grid-column: 1 / -1; }
    .road__marking { animation-duration: 450ms; }
  }
  @media (max-width: 23rem) {
    .hero__call { padding-inline: var(--space-md); }
    .hero__call :global(.chev) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .road__marking { animation: none; }
    .road__seg { transition: none; }
  }
</style>
