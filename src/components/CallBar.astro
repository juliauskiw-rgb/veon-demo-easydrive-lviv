---
import { mainPhone, socials } from "../data/site";
---
<!-- Sticky call bar on phones: appears once the hero call button leaves the screen (R-203). Without script it is always shown. -->
<div class="callbar" data-callbar data-rec="R-203">
  <a class="callbar__btn callbar__btn--call" href={`tel:${mainPhone.tel}`} aria-label={`Подзвонити: ${mainPhone.full}`}>Подзвонити</a>
  <a class="callbar__btn" href={socials.instagram.url} target="_blank" rel="noopener" aria-label="Написати в Instagram (нова вкладка)">Instagram</a>
</div>

<style>
  .callbar { display: none; }
  @media (max-width: 60rem) {
    .callbar {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      position: fixed; inset-inline: 0; bottom: 0; z-index: var(--z-sticky);
      padding: var(--space-2xs) var(--space-2xs) max(var(--space-2xs), env(safe-area-inset-bottom));
      gap: var(--space-2xs); background: var(--color-ink);
      transition: transform var(--dur-short) var(--ease-out);
    }
    :global(.js) .callbar:not(.is-shown) { transform: translateY(110%); }
    .callbar__btn {
      display: flex; align-items: center; justify-content: center; min-height: 56px;
      border-radius: var(--radius); font-weight: 600; text-decoration: none; white-space: nowrap;
      background: var(--color-asphalt-2); color: var(--color-paper);
    }
    .callbar__btn--call { background: var(--color-brand); color: var(--color-ink); }
    .callbar__btn:active { transform: scale(.98); }
    .callbar__btn:focus-visible { outline: 3px solid var(--color-brand); outline-offset: -3px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .callbar { transition: none; }
    .callbar__btn:active { transform: none; }
  }
</style>
