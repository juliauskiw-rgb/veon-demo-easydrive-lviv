---
import FutureLink from "./FutureLink.astro";
import logo from "../assets/logo-easydrive.svg";
import { mainPhone, hours, route, FUTURE } from "../data/site";

const links = [
  { href: "#categories", label: "Категорії" },
  { href: "#branches", label: "Філії" },
  { href: "#theory", label: "Навчання" },
  { href: "#practice", label: "Практика" },
  { href: "#finish", label: "Контакти" },
];
const future = ["Розклад груп", "Ціни", "Питання та відповіді", "Блог"];
---
<header class="site-header" data-header data-rec="R-207">
  <div class="container bar">
    <a class="logo" href="#hero" aria-label="EasyDrive, автошкола: на початок сторінки">
      <img src={logo.src} width="400" height="112" alt="" decoding="async" fetchpriority="high" />
    </a>
    <nav class="nav" id="site-nav" aria-label="Розділи сторінки" data-rec="R-204">
      <ul class="nav__list" role="list">
        {links.map((l) => <li><a class="nav__link" href={l.href} data-nav-link>{l.label}</a></li>)}
      </ul>
      <ul class="nav__future" role="list">
        {future.map((f) => <li><FutureLink note={FUTURE} class="future-link--start">{f}</FutureLink></li>)}
      </ul>
    </nav>
    <p class="hdr-hours small muted" data-rec="R-208">Дзвінки {hours.text}</p>
    <a class="btn nowrap hdr-call" href={`tel:${mainPhone.tel}`} aria-label={`Подзвонити: ${mainPhone.full}`}>
      <span class="hdr-call__long num">{mainPhone.short}</span><span class="hdr-call__short">Подзвонити</span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn data-rec="R-204" hidden>Меню</button>
  </div>
  <div class="progress" aria-hidden="true">
    {route.map((r) => <span class="progress__seg" data-progress={r.id}><span class="progress__fill"></span></span>)}
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: var(--z-nav);
    background: var(--color-paper); color: var(--color-ink);
  }
  .bar {
    display: flex; align-items: center; gap: var(--space-lg);
    min-height: calc(var(--header-h) - 4px);
  }
  .logo { display: inline-flex; flex-shrink: 0; border-radius: 2px; }
  .logo img { width: 156px; height: auto; }
  .logo:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 4px; }

  .nav { margin-inline-start: auto; }
  .nav__list, .nav__future { display: flex; gap: var(--space-xs); margin: 0; padding: 0; list-style: none; }
  .nav__future { display: none; }
  .nav__link {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-sm);
    font-size: var(--text-md); text-decoration: none; white-space: nowrap; border-radius: var(--radius);
    background-image: linear-gradient(var(--color-brand), var(--color-brand));
    background-repeat: no-repeat; background-size: 0 4px; background-position: var(--space-sm) calc(100% - 6px);
    transition: background-size var(--dur-short) var(--ease-out);
  }
  .nav__link:hover, .nav__link[aria-current="true"] { background-size: calc(100% - 2 * var(--space-sm)) 4px; }
  .nav__link:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 0; }

  .hdr-hours { margin: 0; white-space: nowrap; display: none; }
  .hdr-call { min-height: 48px; white-space: nowrap; }
  .hdr-call__short { display: none; }
  .menu-btn {
    display: none; min-height: 48px; padding: 0 var(--space-md);
    border: 0; border-radius: var(--radius); background: transparent; color: var(--color-ink);
    box-shadow: inset 0 0 0 2px var(--color-ink);
    font: 600 var(--text-md)/1 var(--font-body); cursor: pointer;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  @media (hover: hover) { .menu-btn:hover { background: var(--color-brand); } }
  .menu-btn[aria-expanded="true"] { background: var(--color-ink); color: var(--color-brand); }
  .menu-btn:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 3px; }

  /* Route progress under the header: an asphalt strip whose segments fill with yellow (effect 2) */
  .progress { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2px; height: 4px; background: var(--color-paper); }
  .progress__seg { background: var(--color-ink); overflow: hidden; }
  .progress__fill { display: block; height: 100%; background: var(--color-brand); transform: scaleX(0); transform-origin: left; transition: transform 300ms var(--ease-out); }
  :global(.progress__seg.is-done) .progress__fill { transform: scaleX(1); }

  @media (min-width: 75rem) { .hdr-hours { display: block; } }

  @media (max-width: 60rem) {
    .bar { flex-wrap: wrap; gap: var(--space-xs) var(--space-sm); padding-block: var(--space-xs); }
    .logo img { width: 116px; }
    .hdr-call { margin-inline-start: auto; padding: 0 var(--space-md); }
    .hdr-call__long { display: none; }
    .hdr-call__short { display: inline; }
    /* Without script the anchors stay reachable as a scrollable row */
    .nav { order: 5; flex-basis: 100%; margin: 0; overflow-x: auto; }
    .nav__future { display: none; }
    :global(.js) .menu-btn { display: inline-flex; align-items: center; }
    :global(.js) .nav { display: none; }
    :global(.js) .nav.is-open {
      display: block; position: absolute; inset-inline: 0; top: 100%;
      max-height: calc(100dvh - var(--header-h)); overflow-y: auto;
      background: var(--color-paper); padding: var(--space-md) var(--space) var(--space-xl);
      box-shadow: 0 1px 0 var(--color-rule);
    }
    :global(.js) .nav.is-open .nav__list { flex-direction: column; gap: 0; }
    :global(.js) .nav.is-open .nav__link {
      min-height: 56px; font-family: var(--font-display); font-style: var(--slant); font-weight: 800;
      font-size: var(--text-title); padding: 0; background-position: 0 calc(100% - 10px);
    }
    :global(.js) .nav.is-open .nav__link:hover { background-size: 100% 4px; }
    :global(.js) .nav.is-open .nav__future { display: flex; flex-direction: column; gap: 0; margin-top: var(--space-md); padding-top: var(--space-md); border-top: 1px solid var(--color-rule); }
  }
  @media (max-width: 23rem) {
    .bar { gap: var(--space-xs); }
    .logo img { width: 88px; }
    .hdr-call, .menu-btn { padding: 0 var(--space-sm); font-size: var(--text-sm); }
  }
  @media (prefers-reduced-motion: reduce) {
    .progress__fill, .nav__link { transition: none; }
  }
</style>
